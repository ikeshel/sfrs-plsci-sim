# Geometry overview with a limited optical sample, not full collection statistics.
/run/numberOfThreads 1
/run/initialize
/gun/position 0 0 -5 mm
/gun/direction 0 0 1
/beam/alternatePositions false
/optics/transportPhotons true
/optics/maxPhotons 100
/vis/open OGLSQt
/vis/drawVolume
/vis/viewer/set/style wireframe
/vis/viewer/set/viewpointVector 0 0 1
/vis/scene/add/axes 0 0 0 5 cm
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID photonColours
/vis/modeling/trajectories/photonColours/set opticalphoton yellow
/vis/modeling/trajectories/photonColours/set e- red
/vis/modeling/trajectories/photonColours/set gamma green
/vis/modeling/trajectories/photonColours/setDefault blue
/vis/modeling/trajectories/select photonColours
/vis/scene/endOfEventAction accumulate 1
/vis/scene/endOfRunAction refresh
/run/beamOn 1
/vis/viewer/flush
